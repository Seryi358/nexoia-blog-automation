# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# KIE AI (Nano Banana 2 for images)
KIE_API_KEY=your-kie-ai-key

# WordPress REST API
WP_URL=https://nexoia.com
WP_USER=admin
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Scheduler (Mon/Wed/Fri at 9 AM Bogota)
PUBLISH_DAYS=mon,wed,fri
PUBLISH_HOUR=9
PUBLISH_MINUTE=0
TIMEZONE=America/Bogota

# App
APP_PORT=8001
LOG_LEVEL=INFO
