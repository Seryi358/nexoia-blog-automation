# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# KIE AI (Nano Banana 2 for images)
KIE_API_KEY=your-kie-ai-key
KIE_IMAGE_MODEL=nano-banana-2

# WordPress REST API
WP_URL=https://iapractica.co
WP_USER=admin
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Scheduler (Mon/Wed/Fri at 9 AM Bogota)
PUBLISH_DAYS=mon,wed,fri
PUBLISH_HOUR=9
PUBLISH_MINUTE=0
TIMEZONE=America/Bogota

# Content
MIN_WORD_COUNT=2200
MAX_WORD_COUNT=3500

# AdSense (leave empty until approved)
ADSENSE_PUBLISHER_ID=
SITE_NAME=IA Practica

# App
APP_PORT=8001
LOG_LEVEL=INFO
AUTOSEED_ON_STARTUP=true
